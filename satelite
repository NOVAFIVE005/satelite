      '40697': {origin:'Europe',operator:'ESA',category:'Earth observation',mission:'Sentinel-2A captures high-resolution multispectral imagery for land, water, vegetation, and disaster monitoring.'},
      '42063': {origin:'Europe',operator:'ESA',category:'Earth observation',mission:'Sentinel-2B works with Sentinel-2A to provide frequent multispectral views of Earth’s changing surface.'},
      '37849': {origin:'United States',operator:'NOAA · NASA',category:'Weather',mission:'Suomi NPP observes weather, climate, fires, vegetation, and nighttime lights with a suite of Earth science instruments.'},
      '25994': {origin:'United States',operator:'NASA',category:'Earth observation',mission:'Terra studies Earth’s atmosphere, land, and oceans to improve understanding of the global climate system.'},
      '27424': {origin:'United States',operator:'NASA',category:'Earth observation',mission:'Aqua measures Earth’s water cycle, including clouds, precipitation, humidity, sea ice, and ocean conditions.'},
      '41866': {origin:'United States',operator:'NOAA',category:'Weather',mission:'GOES-16 monitors the Western Hemisphere from geostationary orbit, supporting severe-weather forecasting and storm tracking.'},
      '43226': {origin:'United States',operator:'NOAA',category:'Weather',mission:'GOES-17 observes the Pacific and western United States for continuous weather imagery and hazard monitoring.'},
      '43873': {origin:'United States',operator:'U.S. Space Force',category:'Navigation',mission:'GPS III SV01 is part of the Global Positioning System, broadcasting timing and positioning signals to users worldwide.'},
      '41328': {origin:'United States',operator:'NASA · NOAA',category:'Weather',mission:'GOES-16’s geostationary weather mission provides continuous cloud imagery, lightning observations, and space-weather monitoring.'},
      '27386': {origin:'United States',operator:'NASA · NOAA',category:'Weather',mission:'Aqua contributes global observations of atmospheric moisture, clouds, ocean temperature, and ice.'},
      '27453': {origin:'United States',operator:'NASA',category:'Science',mission:'Aura measures atmospheric chemistry and air quality, including ozone and trace gases.'},
      '25989': {origin:'United States',operator:'NASA',category:'Science',mission:'Terra’s instruments track land cover, aerosols, clouds, and surface temperature for Earth system science.'},
      '33595': {origin:'United States',operator:'NASA · NOAA',category:'Weather',mission:'The NOAA/MetOp polar-orbiting programme provides atmospheric soundings and environmental observations for forecasting.'}
    };

    function classify(name) {
      const n = name.toUpperCase();
      if (/GPS|NAVSTAR|GALILEO|BEIDOU|GLONASS|NAVIC/.test(n)) return 'Navigation';
