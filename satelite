    function tickClock(){const now=new Date();$('utcClock').textContent=now.toISOString().slice(11,19)+' UTC';}
    tickClock();setInterval(tickClock,1000);setInterval(()=>{if(satellites.length){renderDetails();updateMotionUi();if(selectedId&&lastOrbitDrawId!==selectedId)drawOrbit(satellites.find(s=>s.id===selectedId));renderList();}},1000);
    loadCatalog();
  </script>
  </body>
