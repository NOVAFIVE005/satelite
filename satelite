  <body>
  <div id="app">
    <header class="topbar">
      <div class="brand"><div class="brand-mark">✳</div><div class="brand-name">ORBIT <span>ATLAS</span></div></div>
      <div class="top-context">A live map of our orbital neighborhood</div>
      <div class="top-spacer"></div>
      <div class="feed-state"><span id="headerDot" class="live-dot pending"></span><span id="feedLabel">CONNECTING TO ORBIT FEED</span></div>
      <div id="utcClock" class="utc-clock">--:--:-- UTC</div>
      <button class="time-button" id="speedToggle" title="Switch between live orbital time and accelerated demo motion">20× DEMO</button>
      <button class="icon-button" id="spinToggle" title="Toggle globe auto-rotation" aria-label="Toggle globe auto-rotation">↻</button>
    </header>
    <main class="workspace">
      <aside class="sidebar">
        <div class="panel-heading"><div><div class="eyebrow">Orbital directory</div><h1 class="panel-title">Satellite watch</h1></div><span id="listCount" class="count-pill">LOADING</span></div>
        <div class="stat-strip"><div><div class="stat-label">Objects in the visual catalog</div><div class="stat-value"><span id="totalCount">—</span> <span>tracked</span></div></div><div style="color:var(--cyan);font-size:17px">⌁</div></div>
        <div class="search-wrap"><span class="search-icon">⌕</span><input id="search" class="search" type="search" placeholder="Search name or NORAD ID" autocomplete="off"></div>
        <div class="filter-row" id="filters">
          <button class="filter-chip active" data-filter="All">All</button><button class="filter-chip" data-filter="Science">Science</button><button class="filter-chip" data-filter="Earth observation">Earth obs.</button><button class="filter-chip" data-filter="Weather">Weather</button><button class="filter-chip" data-filter="Navigation">Navigation</button><button class="filter-chip" data-filter="Communications">Comms</button>
        </div>
        <div class="list-caption"><span>Visible satellites</span><span id="sortLabel">LIVE POSITIONS</span></div>
        <div id="satList" class="sat-list"><div class="empty-list">Connecting to the public orbit catalog…</div></div>
      </aside>
      <section class="globe-wrap" aria-label="Interactive 3D Earth and satellite globe">
        <canvas id="globe"></canvas>
        <div class="view-topline"><div class="view-label"><div class="view-title">Earth · orbital view</div><div id="viewSubtitle" class="view-subtitle">INITIALIZING 3D SCENE</div></div><div class="view-badge"><span id="badgeDot" class="live-dot pending"></span><span id="badgeLabel">ACQUIRING ORBIT DATA</span></div></div>
        <div id="globeLoading" class="globe-loading"><div class="loading-card"><div class="loading-ring"></div><div>BUILDING THE EARTH VIEW</div></div></div>
        <div id="notice" class="notice"></div>
        <div class="globe-controls"><button class="globe-control" id="zoomIn" aria-label="Zoom in" title="Zoom in">+</button><button class="globe-control" id="zoomOut" aria-label="Zoom out" title="Zoom out">−</button><button class="globe-control" id="resetView" aria-label="Reset globe view" title="Reset view">⌖</button></div>
        <div class="scale-note">ORBIT HEIGHTS VISUALLY COMPRESSED · GLOBE IS ROTATABLE</div>
        <div class="interaction-hint"><b>DRAG</b> to orbit &nbsp;·&nbsp; <b>SCROLL</b> to zoom &nbsp;·&nbsp; <b>CLICK</b> a satellite to inspect</div>
      </section>
      <aside class="details">
        <div class="panel-heading"><div><div class="eyebrow">Mission profile</div><h2 class="panel-title">Satellite details</h2></div><span id="detailBadge" class="count-pill">—</span></div>
        <div id="detailEmpty" class="detail-empty"><div class="empty-mark">◎</div>Select a satellite from the directory or click one on the globe to see its orbit, origin, and mission.</div>
        <div id="detailContent" style="display:none;min-height:0;overflow:auto">
          <div class="selected-hero"><div class="hero-top"><div id="heroSymbol" class="hero-symbol">✦</div><div><div id="heroName" class="hero-name"></div><div id="heroId" class="hero-id"></div></div></div><div id="missionTag" class="mission-tag"></div><p id="missionCopy" class="mission-copy"></p></div>
          <div class="section-label">Live orbital telemetry</div>
          <div class="info-grid" id="telemetryGrid"></div>
          <div class="section-label">Origin &amp; mission</div>
          <div class="origin-card"><div class="origin-top"><span id="originName"></span><span id="operatorName"></span></div><div id="originLine" class="origin-line"></div></div>
        </div>
        <div class="data-foot">This is CelesTrak’s Visual group, a sample of bright catalog objects, not a count of every satellite in orbit. Satellite models are illustrative; orbit heights are compressed for the view. Positions use SGP4 and are estimates, not spacecraft telemetry. <a href="https://celestrak.org/NORAD/elements/" target="_blank" rel="noopener">Data source ↗</a><br>Orbit elements refresh at most every 2 hours.</div>
      </aside>
    </main>
  </div>
  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import * as satellite from 'satellite.js';

    const $ = (id) => document.getElementById(id);
    const CACHE_KEY = 'orbit-atlas-visual-tle-v1';
    const REFRESH_MS = 2 * 60 * 60 * 1000;
    const MAX_VISIBLE_LIST = 180;
    const KNOWN = {
      '25544': {origin:'International',operator:'ISS partners',category:'Science',mission:'A continuously crewed research laboratory where international teams run experiments in biology, physics, Earth science, and technology.'},
      '20580': {origin:'United States / Europe',operator:'NASA · ESA',category:'Science',mission:'The Hubble Space Telescope observes distant galaxies, stars, and planets across visible, ultraviolet, and near-infrared light.'},
      '48274': {origin:'China',operator:'China Manned Space Agency',category:'Science',mission:'Tianhe is the core module of China’s Tiangong space station, supporting crewed research and long-duration human spaceflight.'},
      '33591': {origin:'United States',operator:'NOAA',category:'Weather',mission:'NOAA-19 collects polar-orbiting weather and climate observations used for forecasts and environmental monitoring.'},
