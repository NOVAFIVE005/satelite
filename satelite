      '49260': {origin:'United States',operator:'NASA · USGS',category:'Earth observation',mission:'Landsat 9 images Earth’s land and coastal regions to monitor agriculture, forests, water, and long-term surface change.'},
      '39084': {origin:'United States',operator:'NASA · USGS',category:'Earth observation',mission:'Landsat 8 records multispectral imagery that supports land management, disaster response, and decades-long change studies.'},
